{
  "name": "workbench",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck --continue",
    "test": "turbo run test --continue",
    "verify": "pnpm check && pnpm test && pnpm build",
    "app": "pnpm --filter @workbench/desktop dev",
    "app:dev-login": "node scripts/dev_workflow.mjs dev-login",
    "app:stop": "node scripts/dev_workflow.mjs stop",
    "account:list": "node scripts/dev_workflow.mjs account:list",
    "account:provision": "node scripts/dev_workflow.mjs account:provision",
    "account:secrets": "node scripts/dev_workflow.mjs account:secrets",
    "db:reset": "node scripts/dev_workflow.mjs db:reset"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}